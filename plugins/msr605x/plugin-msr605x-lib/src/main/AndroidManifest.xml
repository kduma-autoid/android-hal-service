<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The MSR605X is a USB HID device; USB host is optional so the host app still installs on
         devices without it (the plugin then simply reports itself unavailable). -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

</manifest>

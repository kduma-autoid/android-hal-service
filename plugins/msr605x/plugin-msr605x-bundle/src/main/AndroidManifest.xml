<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The MSR605X is a USB HID device; without USB host the plugin reports itself unsupported. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <service
            android:name=".Msr605xService"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.duma.android.hal.HARDWARE_PLUGIN" />
            </intent-filter>
            <meta-data android:name="plugin.id" android:value="msr605x" />
            <meta-data android:name="plugin.label" android:value="MSR605X Magnetic Card Reader/Writer" />
        </service>

    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <service
            android:name=".SunmiPrinterXManagerService"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.duma.android.hal.HARDWARE_PLUGIN" />
            </intent-filter>
            <meta-data android:name="plugin.id" android:value="sunmi.printerx.manager" />
            <meta-data android:name="plugin.label" android:value="Sunmi PrinterX Manager" />
        </service>

        <service
            android:name=".SunmiPrinterXPrinterService"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.duma.android.hal.HARDWARE_PLUGIN" />
            </intent-filter>
            <meta-data android:name="plugin.id" android:value="sunmi.printerx.printer" />
            <meta-data android:name="plugin.label" android:value="Sunmi PrinterX Printer" />
        </service>

        <service
            android:name=".SunmiPrinterXDrawerService"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.duma.android.hal.HARDWARE_PLUGIN" />
            </intent-filter>
            <meta-data android:name="plugin.id" android:value="sunmi.printerx.drawer" />
            <meta-data android:name="plugin.label" android:value="Sunmi PrinterX Cash Drawer" />
        </service>

        <service
            android:name=".SunmiPrinterXLcdService"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.duma.android.hal.HARDWARE_PLUGIN" />
            </intent-filter>
            <meta-data android:name="plugin.id" android:value="sunmi.printerx.lcd" />
            <meta-data android:name="plugin.label" android:value="Sunmi PrinterX LCD" />
        </service>

    </application>

</manifest>

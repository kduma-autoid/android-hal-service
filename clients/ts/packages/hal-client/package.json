{
  "name": "@kduma-autoid/hal-client",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/http.d.ts",
        "default": "./dist/http.js"
      },
      "require": {
        "types": "./dist/http.d.cts",
        "default": "./dist/http.cjs"
      }
    },
    "./ws": {
      "import": {
        "types": "./dist/ws.d.ts",
        "default": "./dist/ws.js"
      },
      "require": {
        "types": "./dist/ws.d.cts",
        "default": "./dist/ws.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kduma-autoid/hal-client-common": "workspace:*"
  },
  "optionalDependencies": {
    "@kduma-autoid/hal-client-transport-http": "workspace:*",
    "@kduma-autoid/hal-client-transport-ws": "workspace:*"
  }
}
